              </h1>
            </div>
          </div>

          {/* Top Header Right Controls */}
          <div className="flex items-center gap-3">
            {/* Mobile Header Nav Switcher */}
            <div className="md:hidden flex items-center gap-1 overflow-x-auto py-1">
