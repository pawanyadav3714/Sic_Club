      </aside>
      <main className="flex-1 min-w-0 flex flex-col min-h-screen">
        {/* TOP HEADER BAR (SECURITY OPERATIONS CENTER STYLE) */}
        <header className="px-6 py-5 border-b border-[#151c2c] bg-[#06090e]/80 backdrop-blur-xl sticky top-0 z-20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div className="space-y-1">
