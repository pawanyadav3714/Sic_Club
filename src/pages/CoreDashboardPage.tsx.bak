              <p className="text-[10px] text-red-400 font-mono font-bold truncate">Domain: {activeCoreUser.domain || activeCoreUser.designation || 'Club Administration'}</p>
            </div>
          </div>

          {/* Sidebar Section 1: OPERATIONS / MONITORING */}
          <div className="space-y-1">
            <button
