                activeTab === 'dashboard'
                  ? 'bg-[#181116] text-red-400 border border-red-500/40 shadow-md shadow-red-950/40'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#0e131f]'
              }`}
            >
              <div className="flex items-center gap-2.5">
                <Activity className={`w-4 h-4 ${activeTab === 'dashboard' ? 'text-red-400' : 'text-slate-500'}`} />
                <span>SOC Dashboard</span>
              </div>
              <span className="text-[10px] font-mono px-1.5 py-0.5 rounded bg-red-500/20 text-red-300 font-bold">LIVE</span>
            </button>

            <button
              onClick={() => setActiveTab('applications')}
              className={`w-full px-3.5 py-2.5 rounded-xl font-semibold text-xs flex items-center justify-between transition-all cursor-pointer ${
                activeTab === 'applications'
                  ? 'bg-[#181116] text-red-400 border border-red-500/40 shadow-md shadow-red-950/40'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#0e131f]'
              }`}
            >
              <div className="flex items-center gap-2.5">
                <AlertTriangle className={`w-4 h-4 ${activeTab === 'applications' ? 'text-red-400' : 'text-slate-500'}`} />
                <span>Candidate Applications</span>
              </div>
              {applications.length > 0 && (
                <span className="text-[10px] font-mono px-2 py-0.5 rounded-full bg-red-500 text-white font-extrabold shadow-sm">
                  {applications.length}
                </span>
