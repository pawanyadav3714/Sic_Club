                activeTab === 'members'
                  ? 'bg-[#181116] text-red-400 border border-red-500/40 shadow-md shadow-red-950/40'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#0e131f]'
              }`}
            >
              <div className="flex items-center gap-2.5">
                <Users className={`w-4 h-4 ${activeTab === 'members' ? 'text-red-400' : 'text-slate-500'}`} />
                <span>Active Club Roster</span>
              </div>
              <span className="text-[10px] font-mono text-slate-400 font-bold">{approvedMembers.length}</span>
            </button>

            <button
              onClick={() => setActiveTab('announcements')}
              className={`w-full px-3.5 py-2.5 rounded-xl font-semibold text-xs flex items-center justify-between transition-all cursor-pointer ${
                activeTab === 'announcements'
                  ? 'bg-[#181116] text-red-400 border border-red-500/40 shadow-md shadow-red-950/40'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#0e131f]'
              }`}
            >
              <div className="flex items-center gap-2.5">
                <Bell className={`w-4 h-4 ${activeTab === 'announcements' ? 'text-red-400' : 'text-slate-500'}`} />
                <span>Event Notices</span>
              </div>
              <span className="text-[10px] font-mono text-purple-400 font-bold">{announcements.length}</span>
            </button>
          </div>

          {/* Sidebar Section 2: CONFIGURATION & ACCESS */}
          <div className="space-y-1 pt-2">
            <p className="text-[10px] font-mono font-bold tracking-widest text-slate-500 uppercase px-3 mb-2">
              COUNCIL & ACCESS
            </p>

            <button
              onClick={() => setActiveTab('council')}
              className={`w-full px-3.5 py-2.5 rounded-xl font-semibold text-xs flex items-center justify-between transition-all cursor-pointer ${
                activeTab === 'council'
                  ? 'bg-[#181116] text-red-400 border border-red-500/40 shadow-md shadow-red-950/40'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-[#0e131f]'
              }`}
            >
              <div className="flex items-center gap-2.5">
                <Crown className={`w-4 h-4 ${activeTab === 'council' ? 'text-red-400' : 'text-slate-500'}`} />
