                }`}
              >
                Notices
              </button>
            </div>
          </div>
        </header>

        {/* BODY CONTAINER */}
        <div className="p-6 sm:p-8 space-y-8 flex-1">
          {/* TAB 1: SOC OVERVIEW DASHBOARD (EXACT VISUAL COPY OF THE REFERENCE IMAGE) */}
          {activeTab === 'dashboard' && (
            <div className="space-y-8">
              {/* THREAT OVERVIEW METRIC CARDS GRID (6 STAT CARDS MATCHING SCREENSHOT) */}
              <div>
                <p className="text-[11px] font-mono font-bold tracking-widest text-slate-500 uppercase mb-3">
                  THREAT OVERVIEW & OPERATIONAL STATUS
                </p>
                <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
                  {/* Card 2: NEW ALERTS */}
                  <div className="p-4 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-2 relative overflow-hidden group hover:border-amber-500/40 transition-all">
                    <div className="flex items-center justify-between text-slate-400">
                      <span className="text-[10px] font-mono uppercase font-bold tracking-wider">AWAITING TRIAGE</span>
                      <div className="p-1.5 rounded-lg bg-amber-500/10 text-amber-400">
                        <AlertTriangle className="w-3.5 h-3.5" />
                      </div>
                    </div>
                    <div className="space-y-0.5">
                      <p className="text-2xl font-black text-amber-400 font-mono">{applications.length}</p>
                      <p className="text-[10px] text-amber-500/80 font-mono font-bold">requires decision</p>
                    </div>
                  </div>

                  {/* Card 3: OPEN INCIDENTS / ACTIVE MEMBERS */}
                  <div className="p-4 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-2 relative overflow-hidden group hover:border-emerald-500/40 transition-all">
                    <div className="flex items-center justify-between text-slate-400">
                      <span className="text-[10px] font-mono uppercase font-bold tracking-wider">ACTIVE MEMBERS</span>
                      <div className="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400">
                        <Zap className="w-3.5 h-3.5" />
                      </div>
                    </div>
                    <div className="space-y-0.5">
                      <p className="text-2xl font-black text-emerald-400 font-mono">{approvedMembers.length}</p>
                      <p className="text-[10px] text-slate-500 font-mono">accepted in roster</p>
                    </div>
                  </div>

                  {/* Card 4: CRITICAL */}
                  <div className="p-4 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-2 relative overflow-hidden group hover:border-rose-500/40 transition-all">
                    <div className="flex items-center justify-between text-slate-400">
                      <span className="text-[10px] font-mono uppercase font-bold tracking-wider">DECLINED REQS</span>
                      <div className="p-1.5 rounded-lg bg-rose-500/10 text-rose-400">
                        <ShieldAlert className="w-3.5 h-3.5" />
                      </div>
                    </div>
                    <div className="space-y-0.5">
                      <p className="text-2xl font-black text-rose-400 font-mono">{rejectedStudents.length}</p>
                      <p className="text-[10px] text-slate-500 font-mono">archived decisions</p>
                    </div>
                  </div>

                  {/* Card 5: SLA BREACHED / OVERDUE */}
                  <div className="p-4 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-2 relative overflow-hidden group hover:border-purple-500/40 transition-all">
                    <div className="flex items-center justify-between text-slate-400">
                      <span className="text-[10px] font-mono uppercase font-bold tracking-wider">EVENT NOTICES</span>
                      <div className="p-1.5 rounded-lg bg-purple-500/10 text-purple-400">
                        <Bell className="w-3.5 h-3.5" />
                      </div>
                    </div>
                    <div className="space-y-0.5">
                      <p className="text-2xl font-black text-purple-400 font-mono">{announcements.length}</p>
                      <p className="text-[10px] text-slate-500 font-mono">published feed</p>
                    </div>
                  </div>

                  {/* Card 6: AGENTS ONLINE */}
                  <div className="p-4 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-2 relative overflow-hidden group hover:border-cyan-500/40 transition-all">
                    <div className="flex items-center justify-between text-slate-400">
                      <span className="text-[10px] font-mono uppercase font-bold tracking-wider">CORE LEADS</span>
                      <div className="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-400">
                        <Radio className="w-3.5 h-3.5" />
                      </div>
                    </div>
                    <div className="space-y-0.5">
                      <p className="text-2xl font-black text-cyan-400 font-mono">{coreCouncilList.length}/{coreCouncilList.length}</p>
                      <p className="text-[10px] text-cyan-500/80 font-mono font-bold">council active</p>
                    </div>
                  </div>
                </div>
              </div>

              {/* EVENT ANALYSIS ROW: SPLINE LINE GRAPH & DONUT BREAKDOWN (EXACT MATCH TO SCREENSHOT) */}
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {/* 1. Events Timeline Chart (2/3 width) */}
                <div className="lg:col-span-2 p-6 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-4">
                  <div className="flex items-center justify-between">
                    <div>
                      <h2 className="text-sm font-bold text-white font-mono">Events Timeline — Last 24h</h2>
                      <p className="text-xs text-slate-500">Real-time candidate registration and application spikes</p>
                    </div>
                    <span className="text-[10px] font-mono px-2 py-1 rounded bg-[#131b2e] text-slate-400">320 Peak</span>
                  </div>

                  {/* Smooth Vector SVG Chart Curve */}
                  <div className="w-full h-56 relative flex items-end pt-4">
                    <svg className="w-full h-full overflow-visible" viewBox="0 0 500 150" preserveAspectRatio="none">
                      <defs>
                        <linearGradient id="chartGlow" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stopColor="#ef4444" stopOpacity="0.35" />
                          <stop offset="100%" stopColor="#ef4444" stopOpacity="0.0" />
                        </linearGradient>
                      </defs>

                      {/* Area Fill */}
                      <path
                        d="M0,130 Q80,130 140,125 T250,110 T320,30 T400,20 T480,70 L500,80 L500,150 L0,150 Z"
                        fill="url(#chartGlow)"
                      />

                      {/* Stroke Line */}
                      <path
                        d="M0,130 Q80,130 140,125 T250,110 T320,30 T400,20 T480,70 L500,80"
                        fill="none"
                        stroke="#ef4444"
                        strokeWidth="3.5"
                        strokeLinecap="round"
                      />

                      {/* Horizontal Gridlines */}
                      <line x1="0" y1="30" x2="500" y2="30" stroke="#162033" strokeDasharray="3,3" />
                      <line x1="0" y1="70" x2="500" y2="70" stroke="#162033" strokeDasharray="3,3" />
                      <line x1="0" y1="110" x2="500" y2="110" stroke="#162033" strokeDasharray="3,3" />
                    </svg>

                    {/* Chart X-Axis Labels */}
                    <div className="absolute bottom-0 left-0 right-0 flex justify-between text-[10px] font-mono text-slate-500 pt-2 border-t border-[#182136]">
                      <span>14h</span>
                      <span>17h</span>
                      <span>20h</span>
                      <span>23h</span>
                      <span>02h</span>
                      <span>05h</span>
                      <span>08h</span>
                      <span>11h</span>
                    </div>
                  </div>
                </div>

                {/* 2. Severity / Domain Breakdown Donut Chart (1/3 width) */}
                <div className="p-6 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-4 flex flex-col justify-between">
                  <div>
                    <h2 className="text-sm font-bold text-white font-mono">Domain Breakdown (24h)</h2>
                    <p className="text-xs text-slate-500">Applicant distribution across club domains</p>
                  </div>

                  {/* Donut Visualization */}
                  <div className="relative w-40 h-40 mx-auto my-2 flex items-center justify-center">
                    <svg className="w-full h-full -rotate-90" viewBox="0 0 36 36">
                      <path
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        fill="none"
                        stroke="#1a243a"
                        strokeWidth="3.8"
                      />
                      <path
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        fill="none"
                        stroke="#ef4444"
                        strokeWidth="3.8"
                        strokeDasharray="65, 100"
                      />
                      <path
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        fill="none"
                        stroke="#eab308"
                        strokeWidth="3.8"
                        strokeDasharray="20, 100"
                        strokeDashoffset="-65"
                      />
                      <path
                        d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        fill="none"
                        stroke="#6366f1"
                        strokeWidth="3.8"
                        strokeDasharray="15, 100"
                        strokeDashoffset="-85"
                      />
                    </svg>
                    <div className="absolute text-center space-y-0.5">
                      <span className="text-xs font-mono text-slate-500 uppercase font-bold block">TOTAL</span>
                      <span className="text-xl font-black text-white font-mono">{applications.length + approvedMembers.length}</span>
                    </div>
                  </div>

                  {/* Donut Legend */}
                  <div className="space-y-2 font-mono text-xs pt-2 border-t border-[#182136]">
                    <div className="flex items-center justify-between text-slate-300">
                      <div className="flex items-center gap-2">
                        <span className="w-2.5 h-2.5 rounded-full bg-red-500" />
                        <span>Tech / Coding</span>
                      </div>
                      <span className="font-bold">65%</span>
                    </div>
                    <div className="flex items-center justify-between text-slate-300">
                      <div className="flex items-center gap-2">
                        <span className="w-2.5 h-2.5 rounded-full bg-amber-500" />
                        <span>AI & Robotics</span>
                      </div>
                      <span className="font-bold">20%</span>
                    </div>
                    <div className="flex items-center justify-between text-slate-300">
                      <div className="flex items-center gap-2">
                        <span className="w-2.5 h-2.5 rounded-full bg-indigo-500" />
                        <span>Events & Media</span>
                      </div>
                      <span className="font-bold">15%</span>
                    </div>
                  </div>
                </div>
              </div>

              {/* QUICK RECENT CANDIDATE TRIAGE TABLE (LIVE OPERATIONAL FEED) */}
              <div className="p-6 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-4">
                <div className="flex items-center justify-between">
                  <div>
                    <h2 className="text-sm font-bold text-white font-mono flex items-center gap-2">
                      <AlertTriangle className="w-4 h-4 text-amber-400" />
                      <span>Pending Candidate Triage Queue ({applications.length})</span>
                    </h2>
                    <p className="text-xs text-slate-500">Students who filled details and are awaiting decision</p>
                  </div>
                  <button
                    onClick={() => setActiveTab('applications')}
                    className="px-3 py-1.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5"
                  >
                    <span>View All Applications</span>
                    <ArrowRight className="w-3.5 h-3.5" />
                  </button>
                </div>

                {applications.length === 0 ? (
                  <div className="p-8 text-center rounded-xl bg-[#070a12] border border-[#151d30] space-y-2">
                    <CheckCircle className="w-8 h-8 text-emerald-400 mx-auto" />
                    <p className="text-sm font-bold text-white">All Candidate Applications Cleared!</p>
                    <p className="text-xs text-slate-400">No pending requests awaiting decision in the queue.</p>
                  </div>
                ) : (
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {applications.slice(0, 3).map((app) => {
                      const u = app.user;
                      if (!u) return null;
                      return (
                        <div
                          key={app.id}
                          className="p-5 rounded-2xl bg-[#070a12] border border-[#1a243a] hover:border-red-500/40 transition-all space-y-4 flex flex-col justify-between"
                        >
                          <div className="space-y-3">
                            <div className="flex items-center justify-between">
                              <span className="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-amber-500/10 text-amber-400 border border-amber-500/30">
                                AWAITING DECISION
                              </span>
                              <span className="text-[10px] font-mono text-slate-500">
                                {new Date(app.created_at).toLocaleDateString()}
                              </span>
                            </div>

                            <div className="flex items-center gap-3">
                              <div className="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-white text-sm shrink-0">
                                {u.first_name[0]}{u.last_name[0]}
                              </div>
                              <div className="min-w-0 flex-1">
                                <p className="text-sm font-bold text-white truncate">{u.first_name} {u.last_name}</p>
                                <p className="text-xs text-slate-400 truncate">{u.email}</p>
                              </div>
                            </div>

                            <div className="p-3 rounded-xl bg-[#0d1220] border border-[#151c2e] font-mono text-[11px] space-y-1.5">
                              <div className="flex justify-between">
                                <span className="text-slate-500">Reg No:</span>
                                <span className="text-cyan-400 font-bold">{u.registration_no || 'N/A'}</span>
                              </div>
                              <div className="flex justify-between">
                                <span className="text-slate-500">Domain:</span>
                                <span className="text-purple-400 font-bold">{u.domain || 'Tech / Coding'}</span>
                              </div>
                            </div>
                          </div>

                          <div className="flex items-center gap-2 pt-2 border-t border-[#182136]">
                            <button
                              onClick={() => handleApprove(u.id, `${u.first_name} ${u.last_name}`)}
                              className="flex-1 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg transition-all cursor-pointer flex items-center justify-center gap-1.5"
                            >
                              <CheckCircle2 className="w-3.5 h-3.5" />
                              <span>Accept</span>
                            </button>
                            <button
                              onClick={() => handleDecline(u.id, `${u.first_name} ${u.last_name}`)}
                              className="py-2 px-3 rounded-xl bg-red-950/60 hover:bg-red-900/80 border border-red-500/40 text-red-300 font-bold text-xs transition-all cursor-pointer"
                            >
                              <UserX className="w-3.5 h-3.5" />
                            </button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            </div>
          )}

          {/* TAB 2: FULL CANDIDATE APPLICATIONS TRIAGE LIST */}
          {activeTab === 'applications' && (
            <div className="space-y-6">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <h2 className="text-xl font-bold text-white font-mono flex items-center gap-2">
                    <AlertTriangle className="w-5 h-5 text-amber-400" />
                    <span>Student Membership Applications ({filteredApps.length})</span>
                  </h2>
                  <p className="text-xs text-slate-400">Review filled credentials and accept or decline student join requests</p>
                </div>

                {/* Filter Controls */}
                <div className="flex items-center gap-3">
                  <div className="relative">
                    <Search className="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" />
                    <input
                      type="text"
                      value={searchQuery}
                      onChange={(e) => setSearchQuery(e.target.value)}
                      placeholder="Search candidate..."
                      className="pl-9 pr-4 py-2 rounded-xl bg-[#0c101c] border border-[#1b2640] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-red-500 font-medium"
                    />
                  </div>
                  <select
                    value={selectedDomainFilter}
                    onChange={(e) => setSelectedDomainFilter(e.target.value)}
                    className="px-3 py-2 rounded-xl bg-[#0c101c] border border-[#1b2640] text-xs text-slate-200 focus:outline-none cursor-pointer"
                  >
                    {DOMAINS_LIST.map((d) => (
                      <option key={d} value={d} className="bg-slate-950">{d}</option>
                    ))}
                  </select>
                </div>
              </div>

              {filteredApps.length === 0 ? (
                <div className="p-12 text-center rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-3">
                  <CheckCircle2 className="w-12 h-12 text-emerald-400 mx-auto" />
                  <h3 className="text-lg font-bold text-white">No Pending Applications Found</h3>
                  <p className="text-xs text-slate-400">All student registration requests have been addressed.</p>
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                  {filteredApps.map((app) => {
                    const u = app.user;
                    if (!u) return null;
                    return (
                      <div
                        key={app.id}
                        className="p-6 rounded-2xl bg-[#0b0e17] border border-[#1a243a] hover:border-red-500/50 transition-all space-y-5 flex flex-col justify-between shadow-xl"
                      >
                        <div className="space-y-4">
                          <div className="flex items-center justify-between">
                            <span className="px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase bg-amber-500/10 text-amber-400 border border-amber-500/30">
                              PENDING REVIEW
                            </span>
                            <span className="text-[10px] font-mono text-slate-500">
                              {new Date(app.created_at).toLocaleDateString()}
                            </span>
                          </div>

                          <div className="flex items-center gap-3">
                            <div className="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-purple-600 p-[2px] shrink-0">
                              <div className="w-full h-full rounded-2xl bg-slate-900 overflow-hidden flex items-center justify-center font-bold text-white text-base">
                                {u.avatar_url ? (
                                  <img src={u.avatar_url} alt="Candidate" className="w-full h-full object-cover" />
                                ) : (
                                  `${u.first_name[0]}${u.last_name[0]}`
                                )}
                              </div>
                            </div>
                            <div className="min-w-0 flex-1">
                              <p className="text-base font-bold text-white truncate">{u.first_name} {u.last_name}</p>
                              <p className="text-xs text-cyan-400 truncate">{u.email}</p>
                            </div>
                          </div>

                          <div className="p-4 rounded-xl bg-[#060910] border border-[#151c2e] font-mono text-xs space-y-2">
                            <div className="flex justify-between border-b border-[#151c2e] pb-1.5">
                              <span className="text-slate-500">Reg Number:</span>
                              <span className="text-white font-bold">{u.registration_no || 'N/A'}</span>
                            </div>
                            <div className="flex justify-between border-b border-[#151c2e] pb-1.5">
                              <span className="text-slate-500">Academic Branch:</span>
                              <span className="text-slate-300 font-bold truncate max-w-[160px]">{u.branch || 'CSE'}</span>
                            </div>
                            <div className="flex justify-between border-b border-[#151c2e] pb-1.5">
                              <span className="text-slate-500">Applied Domain:</span>
                              <span className="text-purple-400 font-bold">{u.domain || 'Tech / Coding'}</span>
                            </div>
                            {u.phone_no && (
                              <div className="flex justify-between border-b border-[#151c2e] pb-1.5">
                                <span className="text-slate-500">Mobile No:</span>
                                <span className="text-emerald-400 font-bold">{u.phone_no}</span>
                              </div>
                            )}
                            <div className="flex justify-between">
                              <span className="text-slate-500">Session Batch:</span>
                              <span className="text-slate-400">{u.session || '2025-2029'}</span>
                            </div>
                          </div>

                          {u.past_project_repo && (
                            <a
                              href={u.past_project_repo}
                              target="_blank"
                              rel="noreferrer"
                              className="p-2.5 rounded-xl bg-[#0e1526] hover:bg-[#152038] border border-[#1b2a4a] text-xs font-mono text-indigo-300 flex items-center justify-between transition-colors"
                            >
                              <span className="flex items-center gap-1.5 truncate">
                                <Github className="w-3.5 h-3.5 text-indigo-400 shrink-0" />
                                <span className="truncate">{u.past_project_repo}</span>
                              </span>
                              <ExternalLink className="w-3.5 h-3.5 shrink-0" />
                            </a>
                          )}
                        </div>

                        <div className="flex items-center gap-3 pt-3 border-t border-[#182136]">
                          <button
                            onClick={() => handleApprove(u.id, `${u.first_name} ${u.last_name}`)}
                            className="flex-1 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-emerald-950/40 transition-all cursor-pointer flex items-center justify-center gap-2"
                          >
                            <UserCheck className="w-4 h-4" />
                            <span>Accept Member</span>
                          </button>
                          <button
                            onClick={() => handleDecline(u.id, `${u.first_name} ${u.last_name}`)}
                            className="py-3 px-4 rounded-xl bg-red-950/70 hover:bg-red-900/90 border border-red-500/50 text-red-300 font-bold text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center justify-center gap-1.5"
                          >
                            <UserX className="w-4 h-4 text-red-400" />
                            <span>Decline</span>
                          </button>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          )}

          {/* TAB 3: ACTIVE ACCEPTED MEMBERS DIRECTORY */}
          {activeTab === 'members' && (
            <div className="space-y-6">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <h2 className="text-xl font-bold text-white font-mono flex items-center gap-2">
                    <UserCheck className="w-5 h-5 text-emerald-400" />
                    <span>Accepted Student Members Directory ({filteredMembers.length})</span>
                  </h2>
                  <p className="text-xs text-slate-400">Official enrolled student members (Core Council maintained separately)</p>
                </div>

                <div className="relative">
                  <Search className="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2" />
                  <input
                    type="text"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    placeholder="Search roster..."
                    className="pl-9 pr-4 py-2 rounded-xl bg-[#0c101c] border border-[#1b2640] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500"
                  />
                </div>
              </div>

              {filteredMembers.length === 0 ? (
                <div className="p-12 text-center rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-2">
                  <Users className="w-10 h-10 text-slate-600 mx-auto" />
                  <p className="text-sm font-bold text-white">No Members Found</p>
                  <p className="text-xs text-slate-400">Accept candidate applications to build the official club roster.</p>
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {filteredMembers.map((m) => (
                    <div
                      key={m.id}
                      className="p-5 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-3 hover:border-emerald-500/40 transition-all shadow-xl"
                    >
                      <div className="flex items-center gap-4">
                        <div className="w-12 h-12 rounded-xl bg-gradient-to-tr from-emerald-600 to-cyan-600 p-[2px] shrink-0">
                          <div className="w-full h-full rounded-xl bg-slate-900 overflow-hidden flex items-center justify-center font-bold text-white text-sm">
                            {m.avatar_url ? (
                              <img src={m.avatar_url} alt="Member" className="w-full h-full object-cover" />
                            ) : (
                              `${m.first_name[0]}${m.last_name[0]}`
                            )}
                          </div>
                        </div>
                        <div className="min-w-0 flex-1 space-y-1">
                          <div className="flex items-center justify-between">
                            <p className="text-sm font-bold text-white truncate">{m.first_name} {m.last_name}</p>
                            <span className="px-2 py-0.5 rounded text-[9px] font-mono font-extrabold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
                              Active
                            </span>
                          </div>
                          <p className="text-xs text-cyan-400 truncate">{m.email}</p>
                          <div className="flex flex-wrap items-center gap-2 sm:gap-3 text-[10px] font-mono text-slate-400 pt-0.5">
                            <span>REG: <strong className="text-slate-200">{m.registration_no || 'N/A'}</strong></span>
                            <span>•</span>
                            <span className="text-purple-300 font-bold">{m.domain || 'Tech'}</span>
                            {m.phone_no && (
                              <>
                                <span>•</span>
                                <span className="text-emerald-300 font-bold">📱 {m.phone_no}</span>
                              </>
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Action Bar: Delete Student Profile */}
                      <div className="pt-2 border-t border-[#182136] flex items-center justify-between">
                        <span className="text-[10px] font-mono text-slate-500">Access: Approved Member</span>
                        <button
                          onClick={() => handleDeleteStudent(m.id, `${m.first_name} ${m.last_name}`)}
                          className="px-2.5 py-1.5 rounded-lg bg-red-950/60 hover:bg-red-900/80 border border-red-500/40 text-red-300 hover:text-white text-[11px] font-mono font-bold transition-all cursor-pointer flex items-center gap-1.5"
                          title="Delete profile from database (forces student to re-register & await approval)"
                        >
                          <Trash2 className="w-3.5 h-3.5 text-red-400" />
                          <span>Delete Profile</span>
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* TAB 4: EVENT NOTICES & BROADCAST ANNOUNCEMENTS */}
          {activeTab === 'announcements' && (
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
              {/* Form Column (1/3) */}
              <div className="p-6 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-5 h-fit sticky top-24">
                <div className="border-b border-[#182136] pb-3 space-y-1">
                  <h2 className="text-base font-extrabold text-white font-mono flex items-center gap-2">
                    <Bell className="w-4 h-4 text-purple-400" />
                    <span>Publish Event Notice</span>
                  </h2>
                  <p className="text-xs text-slate-400">Post announcements displaying your Core Lead name and designation</p>
                </div>

                <form onSubmit={handlePostNotice} className="space-y-4">
                  {/* Select Core Lead Author */}
                  <div>
                    <label className="block text-[10px] font-mono uppercase font-bold text-slate-400 mb-1">
                      Publishing Core Member Author
                    </label>
                    <select
                      value={selectedAuthorId}
                      onChange={(e) => setSelectedAuthorId(e.target.value)}
                      className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#182238] text-xs text-white focus:outline-none focus:border-purple-500 font-medium cursor-pointer"
                    >
                      {coreCouncilList.map((c) => (
                        <option key={c.id} value={c.id} className="bg-slate-950 text-white">
                          {c.first_name} {c.last_name} ({c.designation || 'Core Lead'})
                        </option>
                      ))}
                    </select>
                  </div>

                  <div>
                    <label className="block text-[10px] font-mono uppercase font-bold text-slate-400 mb-1">
                      Notice Title
                    </label>
                    <input
                      type="text"
                      required
                      value={newTitle}
                      onChange={(e) => setNewTitle(e.target.value)}
                      placeholder="e.g. 🚀 INNOVISION 2026 Hackathon Registrations Open!"
                      className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#182238] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 font-medium"
                    />
                  </div>

                  <div className="grid grid-cols-2 gap-3">
                    <div>
                      <label className="block text-[10px] font-mono uppercase font-bold text-slate-400 mb-1">
                        Category
                      </label>
                      <select
                        value={annCategory}
                        onChange={(e: any) => setAnnCategory(e.target.value)}
                        className="w-full px-3 py-2.5 rounded-xl bg-[#060910] border border-[#182238] text-xs text-slate-200 focus:outline-none cursor-pointer"
                      >
                        <option value="Event Notice">Event Notice</option>
                        <option value="Workshop">Workshop</option>
                        <option value="Hackathon">Hackathon</option>
                        <option value="Recruitment">Recruitment</option>
                        <option value="General Notice">General Notice</option>
                      </select>
                    </div>

                    <div>
                      <label className="block text-[10px] font-mono uppercase font-bold text-slate-400 mb-1">
                        Event Date
                      </label>
                      <input
                        type="date"
                        value={eventDate}
                        onChange={(e) => setEventDate(e.target.value)}
                        className="w-full px-3 py-2.5 rounded-xl bg-[#060910] border border-[#182238] text-xs text-white focus:outline-none cursor-pointer"
                      />
                    </div>
                  </div>

                  <div>
                    <label className="block text-[10px] font-mono uppercase font-bold text-slate-400 mb-1">
                      Event Location / Venue
                    </label>
                    <input
                      type="text"
                      value={eventLocation}
                      onChange={(e) => setEventLocation(e.target.value)}
                      placeholder="Main University Auditorium"
                      className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#182238] text-xs text-white placeholder-slate-500 focus:outline-none font-medium"
                    />
                  </div>

                  <div>
                    <label className="block text-[10px] font-mono uppercase font-bold text-slate-400 mb-1">
                      Notice Content Details
                    </label>
                    <textarea
                      required
                      rows={4}
                      value={newContent}
                      onChange={(e) => setNewContent(e.target.value)}
                      placeholder="Provide full details regarding schedule, rules, guidelines or registration links..."
                      className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#182238] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 font-medium resize-none"
                    />
                  </div>

                  <button
                    type="submit"
                    className="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-purple-950/50 transition-all cursor-pointer flex items-center justify-center gap-2"
                  >
                    <Bell className="w-4 h-4" />
                    <span>Publish Event Notice</span>
                  </button>
                </form>
              </div>

              {/* Feed Column (2/3) */}
              <div className="lg:col-span-2 space-y-4">
                <div className="flex items-center justify-between pb-2 border-b border-[#182136]">
                  <h2 className="text-base font-bold text-white font-mono">Published Event Notices Feed ({announcements.length})</h2>
                  <span className="text-xs text-slate-400 font-mono">Live on Student Member Portal</span>
                </div>

                <div className="space-y-4">
                  {announcements.map((ann) => (
                    <div
                      key={ann.id}
                      className="p-6 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-4 hover:border-purple-500/40 transition-all shadow-xl"
                    >
                      <div className="flex items-start justify-between gap-4">
                        <div className="space-y-1">
                          <div className="flex items-center gap-2 flex-wrap">
                            <span className="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-purple-500/10 text-purple-300 border border-purple-500/30">
                              {ann.category || 'Event Notice'}
                            </span>
                            <span className="text-[10px] font-mono text-slate-500">
                              {new Date(ann.created_at).toLocaleDateString()}
                            </span>
                          </div>
                          <h3 className="text-lg font-extrabold text-white tracking-tight">{ann.title}</h3>
                        </div>

                        <button
                          onClick={() => handleDeleteNotice(ann.id)}
                          className="p-2 rounded-xl bg-red-950/40 hover:bg-red-900/60 border border-red-500/30 text-red-400 transition-colors cursor-pointer shrink-0"
                          title="Delete notice"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>

                      <p className="text-xs text-slate-300 leading-relaxed font-normal whitespace-pre-line bg-[#060910] p-4 rounded-xl border border-[#151c2e]">
                        {ann.content}
                      </p>

                      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 text-xs font-mono border-t border-[#182136]">
                        {/* Author Info */}
                        <div className="flex items-center gap-2.5">
                          <img
                            src={ann.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=120'}
                            alt={ann.author_name}
                            className="w-7 h-7 rounded-full object-cover border border-purple-500/40"
                          />
                          <div>
                            <span className="text-slate-200 font-bold block">{ann.author_name}</span>
                            <span className="text-[10px] text-purple-400 font-bold">{ann.author_role}</span>
                          </div>
                        </div>

                        {/* Date & Venue */}
                        <div className="flex items-center gap-4 text-[11px] text-slate-400">
                          {ann.event_date && (
                            <span className="flex items-center gap-1">
                              <CalendarIcon className="w-3.5 h-3.5 text-purple-400" />
                              <span>{ann.event_date}</span>
                            </span>
                          )}
                          {ann.event_location && (
                            <span className="flex items-center gap-1">
                              <MapPin className="w-3.5 h-3.5 text-indigo-400" />
                              <span className="truncate max-w-[150px]">{ann.event_location}</span>
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* TAB 5: MULTI-CORE COUNCIL ROSTER */}
          {activeTab === 'council' && (
            <div className="space-y-6">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <h2 className="text-xl font-bold text-white font-mono flex items-center gap-2">
                    <Crown className="w-5 h-5 text-indigo-400" />
                    <span>SIC Core Council Members ({coreCouncilList.length})</span>
                  </h2>
                  <p className="text-xs text-slate-400">Multiple core members with independent profile details and notice posting access</p>
                </div>
               <button 
                 onClick={exportCouncilToExcel}
                 className="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-lg transition-all"
               >
                 Export to Excel
               </button>
               <button 
                 onClick={() => { resetCoreMembersToDefaults(); loadData(); }}
                 className="px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-xs font-bold rounded-lg transition-all"
               >
                 Reset Members
               </button>
             </div>

             <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                {coreCouncilList.map((c) => {
                  const isActive = activeCoreUser.id === c.id;
                  return (
                    <div
                      key={c.id}
                      className={`p-6 rounded-2xl bg-[#0b0e17] border transition-all shadow-xl ${
                        isActive ? 'border-indigo-500 ring-2 ring-indigo-500/20' : 'border-[#182136] hover:border-indigo-500/40'
                      }`}
                    >
                      <div className="flex items-start justify-between gap-3 mb-6">
                        <div className="flex items-center gap-4">
                          <div className="w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-500 to-purple-600 p-[2px]">
                            <div className="w-full h-full rounded-2xl bg-slate-900 overflow-hidden flex items-center justify-center text-xl font-black text-white">
                              {c.avatar_url ? (
                                <img src={c.avatar_url} alt="Core" className="w-full h-full object-cover" />
                              ) : (
                                `${c.first_name[0]}${c.last_name[0]}`
                              )}
                            </div>
                          </div>
                          <div>
                            <h3 className="text-lg font-extrabold text-white">{c.first_name} {c.last_name}</h3>
                            <p className="text-sm text-indigo-400 font-medium">{c.designation || 'Core Council Member'}</p>
                            <p className="text-xs text-slate-500 font-mono truncate">{c.email}</p>
                          </div>
                        </div>
                        <button 
                          onClick={() => { 
                            deleteStoredCoreMember(c.id); 
                            setCoreCouncilList(getStoredCoreMembers()); 
                          }}
                          className="text-slate-600 hover:text-red-500 transition-colors p-2"
                        >
                          <Trash2 className="w-5 h-5" />
                        </button>
                      </div>

                      <div className="grid grid-cols-2 gap-3 text-xs">
                        <div className="p-3 rounded-lg bg-[#060910] border border-[#151c2e]">
                          <p className="text-slate-500 font-mono">First Name</p>
                          <p className="text-slate-200 font-bold text-sm">{c.first_name}</p>
                        </div>
                        <div className="p-3 rounded-lg bg-[#060910] border border-[#151c2e]">
                          <p className="text-slate-500 font-mono">Last Name</p>
                          <p className="text-slate-200 font-bold text-sm">{c.last_name}</p>
                        </div>
                        <div className="p-3 rounded-lg bg-[#060910] border border-[#151c2e] col-span-2">
                          <p className="text-slate-500 font-mono">Department / Branch</p>
                          <p className="text-slate-200 font-bold text-sm">{c.branch || 'N/A'}</p>
                        </div>
                        <div className="p-3 rounded-lg bg-[#060910] border border-[#151c2e]">
                          <p className="text-slate-500 font-mono">Session</p>
                          <p className="text-slate-200 font-bold text-sm">{c.session || 'N/A'}</p>
                        </div>
                        <div className="p-3 rounded-lg bg-[#060910] border border-[#151c2e]">
                          <p className="text-slate-500 font-mono">Registration No.</p>
                          <p className="text-slate-200 font-bold text-sm">{c.registration_no || 'N/A'}</p>
                        </div>
                        <div className="p-3 rounded-lg bg-[#060910] border border-[#151c2e]">
                          <p className="text-slate-500 font-mono">Domain</p>
                          <p className="text-slate-200 font-bold text-sm">{c.domain || 'N/A'}</p>
                        </div>
                        <div className="p-3 rounded-lg bg-[#060910] border border-[#151c2e]">
                          <p className="text-slate-500 font-mono">Phone</p>
                          <p className="text-slate-200 font-bold text-sm">{c.phone_no || 'N/A'}</p>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* TAB 6: DECLINED APPLICATIONS ARCHIVE */}
          {activeTab === 'rejected' && (
            <div className="space-y-6">
              <div className="flex items-center justify-between">
                <div>
                  <h2 className="text-xl font-bold text-white font-mono flex items-center gap-2">
                    <UserX className="w-5 h-5 text-rose-400" />
                    <span>Declined Applications Archive ({rejectedStudents.length})</span>
                  </h2>
                  <p className="text-xs text-slate-400">Applications reviewed and declined by the Core Coordinator</p>
                </div>
              </div>

              {rejectedStudents.length === 0 ? (
                <div className="p-12 text-center rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-2">
                  <CheckCircle2 className="w-10 h-10 text-emerald-400 mx-auto" />
                  <p className="text-sm font-bold text-white">No Declined Applications</p>
                  <p className="text-xs text-slate-400">No student requests have been declined.</p>
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {rejectedStudents.map((r) => (
                    <div
                      key={r.id}
                      className="p-5 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-4 hover:border-rose-500/40 transition-all opacity-80 hover:opacity-100"
                    >
                      <div className="flex items-center gap-3">
                        <div className="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-white text-sm shrink-0">
                          {r.first_name[0]}{r.last_name[0]}
                        </div>
                        <div className="min-w-0 flex-1">
                          <p className="text-sm font-bold text-white truncate">{r.first_name} {r.last_name}</p>
                          <p className="text-xs text-rose-400 truncate">{r.email}</p>
                        </div>
                      </div>

                      <div className="p-3 rounded-xl bg-[#060910] border border-[#151c2e] font-mono text-[11px] space-y-1">
                        <div className="flex justify-between">
                          <span className="text-slate-500">Reg No:</span>
                          <span className="text-slate-300 font-bold">{r.registration_no || 'N/A'}</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-slate-500">Domain:</span>
                          <span className="text-purple-400 font-bold">{r.domain || 'Tech'}</span>
                        </div>
                      </div>

                      <button
                        onClick={() => handleApprove(r.id, `${r.first_name} ${r.last_name}`)}
                        className="w-full py-2 px-3 rounded-xl bg-slate-800 hover:bg-emerald-600 text-slate-200 hover:text-white font-bold text-xs transition-all cursor-pointer flex items-center justify-center gap-2"
                      >
                        <RotateCcw className="w-3.5 h-3.5" />
                        <span>Re-Evaluate & Accept</span>
                      </button>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* TAB 7: DATABASE & SQL SCHEMA SCHEMA TOOLS */}
          {activeTab === 'sql' && (
            <div className="space-y-6">
              <div className="p-6 rounded-2xl bg-[#0b0e17] border border-[#182136] space-y-4">
                <div className="flex items-center justify-between">
                  <div className="space-y-1">
                    <h2 className="text-base font-bold text-white font-mono flex items-center gap-2">
                      <Database className="w-4 h-4 text-emerald-400" />
                      <span>PostgreSQL Database & Schema Blueprint</span>
                    </h2>
                    <p className="text-xs text-slate-400">Copy or execute SQL DDL for remote PostgreSQL or Supabase instances</p>
                  </div>

                  <button
                    onClick={() => {
                      navigator.clipboard.writeText(SUPABASE_SQL_MIGRATION);
                      setCopiedSql(true);
                      setTimeout(() => setCopiedSql(false), 2500);
                      showNotification('SQL Migration script copied to clipboard!', 'success');
                    }}
                    className="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-all cursor-pointer flex items-center gap-2 shadow-lg"
                  >
                    {copiedSql ? <Check className="w-4 h-4 text-white" /> : <Copy className="w-4 h-4" />}
                    <span>{copiedSql ? 'Copied SQL!' : 'Copy SQL Script'}</span>
                  </button>
                </div>

                <div className="p-4 rounded-xl bg-[#04060a] border border-[#141b2c] font-mono text-xs text-emerald-300 overflow-x-auto max-h-96 leading-relaxed">
                  <pre>{SUPABASE_SQL_MIGRATION}</pre>
                </div>
              </div>
            </div>
          )}
        </div>
      </main>

      {/* MODAL: ADD CORE MEMBER COUNCIL FORM */}
      {showAddCoreModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <motion.div
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            className="w-full max-w-md p-7 rounded-3xl bg-[#0c101d] border border-[#1e273a] space-y-5 relative shadow-2xl"
          >
            <div className="flex items-center justify-between border-b border-[#1e273a] pb-3">
              <h3 className="text-lg font-extrabold text-white flex items-center gap-2">
                <Crown className="w-5 h-5 text-indigo-400" />
                <span>Add Core Council Member</span>
              </h3>
              <button
                onClick={() => setShowAddCoreModal(false)}
                className="text-slate-400 hover:text-white p-1"
              >
                <XCircle className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleAddCoreMember} className="space-y-4">
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[10px] font-mono uppercase text-slate-400 mb-1">First Name</label>
                  <input
                    type="text"
                    required
                    value={newCoreFirst}
                    onChange={(e) => setNewCoreFirst(e.target.value)}
                    placeholder="e.g. Aarav"
                    className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#1b2640] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-medium"
                  />
                </div>
                <div>
                  <label className="block text-[10px] font-mono uppercase text-slate-400 mb-1">Last Name</label>
                  <input
                    type="text"
                    required
                    value={newCoreLast}
                    onChange={(e) => setNewCoreLast(e.target.value)}
                    placeholder="e.g. Sharma"
                    className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#1b2640] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-medium"
                  />
                </div>
              </div>

              <div>
                <label className="block text-[10px] font-mono uppercase text-slate-400 mb-1">Official Core Email</label>
                <input
                  type="email"
                  required
                  value={newCoreEmail}
                  onChange={(e) => setNewCoreEmail(e.target.value)}
                  placeholder="aarav.tech@sic.edu"
                  className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#1b2640] text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-medium"
                />
              </div>

              <div>
                <label className="block text-[10px] font-mono uppercase text-slate-400 mb-1">Council Designation</label>
                <select
                  value={newCoreDesignation}
                  onChange={(e) => setNewCoreDesignation(e.target.value)}
                  className="w-full px-3.5 py-2.5 rounded-xl bg-[#060910] border border-[#1b2640] text-xs text-slate-200 focus:outline-none cursor-pointer"
                >
                  {DESIGNATIONS_LIST.map((d) => (
                    <option key={d} value={d} className="bg-slate-950">{d}</option>
                  ))}
                </select>
              </div>

              <div className="flex items-center gap-3 pt-2">
                <button
                  type="button"
                  onClick={() => setShowAddCoreModal(false)}
                  className="w-full py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition-all cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="w-full py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition-all shadow-lg shadow-indigo-950/50 cursor-pointer flex items-center justify-center gap-2"
                >
                  <UserPlus className="w-4 h-4" />
                  <span>Add to Council</span>
                </button>
              </div>
            </form>
          </motion.div>
        </div>
      )}
    </div>
  );
}
